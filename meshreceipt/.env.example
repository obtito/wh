# Copy to .env locally. Never commit or send keys in chat. Keep your chosen model; do not infer availability.
# Configuration alone is not a successful connection. UI requests require explicit data/cost confirmation.
# npm run agent:smoke makes at most 6 requests (1800 output tokens each) for one project-owned sample.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Responses reasoning.effort; max is opt-in, not a mapping of Codex ultra or a billing multiplier.
OPENAI_REASONING_EFFORT=medium
# Optional Responses-compatible endpoint, trusted server configuration only.
OPENAI_BASE_URL=https://api.openai.com/v1
PORT=4318
# Wallet transactions are disabled until a deployed address is configured.
MESHRECEIPT_CHAIN_ID=677
MESHRECEIPT_CONTRACT_ADDRESS=
